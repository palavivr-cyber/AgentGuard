# Copy this file to .streamlit/secrets.toml and fill in the values from your
# Moss project dashboard. The real secrets file is ignored by Git.
MOSS_PROJECT_ID = "your-project-id"
MOSS_PROJECT_KEY = "your-project-key"
# Must match the index created by scripts/seed_moss.py.
MOSS_INDEX_NAME = "agentguard-context"

# Optional: Moss is enabled automatically when project credentials exist.
# Set this to "false" only to deliberately force the local demo provider.
MOSS_ENABLED = "true"
